package tests;

use ecosystem::terminal;
use std::context;
use std::os::linux::fd;
use std::bytes::endian;
use std::testing;
use std::time;

fn successive_escape_deadlines(writer: fd::Fd, session: terminal::Session) -> () {
    let ctx = context::Context::background();
    testing::assert_ok(writer.write_all("\u001b[".to_bytes().as_slice()));
    testing::assert_none(testing::expect_ok(session.next_event(ctx, 0), "first escape"));
    time::sleep(time::Duration::from_milliseconds(600));
    testing::assert_ok(writer.write_all("A\u001b[".to_bytes().as_slice()));
    testing::assert(
        testing::expect_ok(session.next_event(ctx, 100), "first key")
            == Option::Some(
                terminal::Event::Key(
                    terminal::KeyEvent {
                        code: terminal::KeyCode::Up,
                        modifiers: terminal::Modifiers::none(),
                    },
                ),
            ),
    );
    time::sleep(time::Duration::from_milliseconds(600));
    testing::assert_ok(writer.write_all("B".to_bytes().as_slice()));
    testing::assert(
        testing::expect_ok(session.next_event(ctx, 100), "second key gets new deadline")
            == Option::Some(
                terminal::Event::Key(
                    terminal::KeyEvent {
                        code: terminal::KeyCode::Down,
                        modifiers: terminal::Modifiers::none(),
                    },
                ),
            ),
    );
    testing::assert_ok(writer.write_all("\u001b".to_bytes().as_slice()));
    testing::assert_none(testing::expect_ok(session.next_event(ctx, 0), "third escape"));
    time::sleep(time::Duration::from_milliseconds(600));
    testing::assert_ok(writer.write_all("[".to_bytes().as_slice()));
    testing::assert_none(testing::expect_ok(session.next_event(ctx, 0), "same escape fragment"));
    time::sleep(time::Duration::from_milliseconds(600));
    testing::assert(
        testing::expect_ok(session.next_event(ctx, 0), "same sequence keeps original deadline")
            == Option::Some(terminal::Event::Unknown("\u001b[")),
    );
}

#[test]
fn real_pty_successive_escape_deadlines_restore_terminal_state() -> () {
    let master = testing::expect_ok(
        fd::open("/dev/ptmx", fd::O_RDWR | fd::O_NOCTTY, 0),
        "PTY master",
    );
    defer {
        let _ = master.close();
    };
    let zeroes = Vec::from_array([0, 0, 0, 0]);
    testing::assert_ok(master.ioctl(0x40045431, zeroes.as_mut_slice()));
    testing::assert_ok(master.ioctl(0x80045430, zeroes.as_mut_slice()));
    let number = testing::expect_ok(
        endian::read_u32(zeroes.as_slice(), 0, endian::Endian::Little),
        "PTY number",
    );
    let slave = testing::expect_ok(
        fd::open("/dev/pts/" + number.to_string(), fd::O_RDWR | fd::O_NOCTTY, 0),
        "PTY slave",
    );
    defer {
        let _ = slave.close();
    };
    let before = Vec::new();
    let after = Vec::new();
    for _ in 0..36 {
        before.push(0);
        after.push(0);
    }
    testing::assert_ok(slave.ioctl(0x5401, before.as_mut_slice()));
    let flags = testing::expect_ok(slave.status_flags(), "original flags");
    let session = testing::expect_ok(
        terminal::Session::from_fds(
            slave,
            slave,
            terminal::Options {
                raw_mode: true,
                escape_timeout_ms: 1000,
                ..terminal::Options::defaults(),
            },
        ),
        "raw session",
    );
    defer {
        let _ = session.close();
    };
    successive_escape_deadlines(master, session);
    testing::assert_ok(session.close());
    testing::assert_ok(slave.ioctl(0x5401, after.as_mut_slice()));
    testing::assert(before == after);
    testing::assert_eq(testing::expect_ok(slave.status_flags(), "restored flags"), flags);
}
